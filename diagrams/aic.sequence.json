  "cards": [
    {
      "dot": "emerald",
      "title": "Sync Flow",
      "items": [
        "Stage, commit, and pull --rebase keep history linear",
        "Conflicts surface as a file list, not parsed error text",
        "ours/theirs meaning flips under rebase; sides swap before prompting"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety Before AI",
      "items": [
        "Both conflict sides pass SecretScanner before leaving the machine",
        "Resolver uses generateResponse, never the commit-message path",
        "Failure falls back to the local version, not the incoming one"
      ]
    },
    {
      "dot": "orange",
      "title": "Human Gate",
      "items": [
        "AI writes to the working tree but never commits",
        "A 100-line diff preview precedes the accept prompt",
        "Discard aborts the sync; the branch stays untouched"
      ]
    }
  ]
