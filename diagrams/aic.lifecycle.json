  "cards": [
    {
      "dot": "emerald",
      "title": "Main Path",
      "items": [
        "Five phases from invocation to pushed branch on one rail",
        "Pull uses rebase so history stays linear",
        "Completion is a phase, not a detached side box"
      ]
    },
    {
      "dot": "amber",
      "title": "Waits and Bypass",
      "items": [
        "Conflicted rebase pauses for AI resolution plus human review",
        "Pull can be skipped explicitly; push still runs",
        "Wait states stay non-terminal until a decision is made"
      ]
    },
    {
      "dot": "rose",
      "title": "Recovery and Exits",
      "items": [
        "Accept loops back into the pull phase via rebase --continue",
        "Abort leaves the branch exactly as it was",
        "Generation fails only after both providers are exhausted"
      ]
    }
  ]
