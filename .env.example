# AI Commit Generator - Environment Variables
# Copy this file to .env and fill in your values

# Groq API key (required for Groq provider)
GROQ_API_KEY=your_groq_api_key_here

# Model to use (default: openai/gpt-oss-20b)
AIC_MODEL=openai/gpt-oss-20b

# Provider: "groq" or "ollama" (default: groq)
AIC_PROVIDER=groq

# Debug project type detection (optional)
# DEBUG_PROJECT_TYPE=1
